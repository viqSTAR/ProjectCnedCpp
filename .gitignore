# ==============================================================================
# Unreal Engine 5 C++ Project .gitignore
# ==============================================================================

# Unreal Engine generated directories
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/Receipts/

# Plugin generated directories
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/DerivedDataCache/
Plugins/*/Saved/

# Local developer folders inside Content
Content/Developers/
Content/Collections/

# Visual Studio & IDE generated files
.vs/
.vscode/
.idea/
.vsidx/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.user
*.userosscache
*.sln.docstates
*.db
*.opendb

# Xcode / Linux / CMake / Clang generated files
*.xcodeproj
*.xcworkspace
Makefile
CMakeLists.txt
.clangd
compile_commands.json

# Compiled binaries & build artifacts
*.obj
*.pdb
*.ilk
*.pch
*.ipch
*.tlog
*.log
*.tmp
*.bak
*.swp
*.dmp

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
